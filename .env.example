# Haxball (atualizado também via POST /token)
HAXBALL_TOKEN=

# Sala
ROOM_NAME=☭🚩 FUTZERA | X4 RETURN 🚩☭
ROOM_PUBLIC=true
ROOM_MAX_PLAYERS=30
ROOM_PASSWORD=
# Bandeira 🇨🇳; ~163km de Pouso Alegre (mesma faixa Futsalzito / Xupiscarena)
GEO=CN
GEO_LAT=-23.0295
GEO_LON=-47.2673

# Mapas vêm hardcoded em src/room/stadiums.js. Opcional: sobrescrever com JSON numa linha
MAP_TRAINING=
MAP_X3=
MAP_X4=

# Score / tempo
SCORE_LIMIT=3
TIME_LIMIT=4
TEAM_SIZE=4
CHOOSE_TIME_SEC=20

# 4 mensagens públicas em 5s → mute 30s
CHAT_FLOOD_LIMIT=4
CHAT_FLOOD_WINDOW_MS=5000
CHAT_FLOOD_MUTE_MS=30000

# Anti-abuso na entrada
# Mesma auth já na sala → kicka a sessão antiga (reconexão/aba duplicada)
GHOST_KICK=true
# Máximo de jogadores pela mesma conexão (0 = sem limite)
MAX_PER_CONN=2

# Supabase (service role só na VM)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord — entradas (auth/conn/IP)
DISCORD_WEBHOOK_URL=
# Discord — replay .hbr2 + resumo (se vazio, usa o de cima)
DISCORD_REPLAY_WEBHOOK_URL=
# Discord — cada ban (!ban e painel). Se vazio, usa o webhook padrão da sala.
DISCORD_BAN_WEBHOOK_URL=
# Discord — log do chat da sala (lote a cada 4s). Se vazio, usa o webhook padrão.
DISCORD_CHAT_WEBHOOK_URL=
DISCORD_CHAT_FLUSH_MS=4000

# API local de token / restart (só na VM, proteja com secret)
TOKEN_API_PORT=3847
TOKEN_API_SECRET=troque-este-secret
PM2_PROCESS_NAME=sala-x4

# Discord da comunidade (comando !discord)
DISCORD_INVITE_URL=https://discord.gg/ZTu7zwgvhm

# Site (comando !site) e carrossel a cada 10 min: Discord → site → gols → partidas
SITE_URL=https://www.haxbook.com.br
CAROUSEL_MS=600000

# API do site — POST após 4v4 válido (começou e terminou 4v4). Sem key não envia.
# HAXBOOK_STATS_URL=https://api.haxbook.com.br/api/webhooks/servers/COMUNISMO/rooms/comunax4/stats
HAXBOOK_API_KEY=
HAXBOOK_ROOM_NAME=Comunismo x4
