# Haxball (atualizado também via POST /token)
HAXBALL_TOKEN=

# Sala
ROOM_NAME=⬆ HAXBOOK | X4 NÍVEL 75+ ⬆
ROOM_PUBLIC=true
ROOM_MAX_PLAYERS=30
ROOM_PASSWORD=
# Gate: rating do site > MIN_RATING. Site fora = deixa entrar.
MIN_RATING=75
# Bandeira 🇨🇳; ~163km de Pouso Alegre (mesma faixa Futsalzito / Xupiscarena)
GEO=CN
GEO_LAT=-23.0295
GEO_LON=-47.2673

# Mapas vêm hardcoded em src/room/stadiums.js. Opcional: sobrescrever com JSON numa linha
MAP_TRAINING=
MAP_X3=
MAP_X4=

# Score / tempo
SCORE_LIMIT=3
TIME_LIMIT=4
TEAM_SIZE=4
CHOOSE_TIME_SEC=15

# 4 mensagens públicas em 5s → mute 30s
CHAT_FLOOD_LIMIT=4
CHAT_FLOOD_WINDOW_MS=5000
CHAT_FLOOD_MUTE_MS=30000

# Supabase (service role só na VM) — banco/projeto próprio desta sala
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord — entradas (auth/conn/IP) — canais próprios da Nível
DISCORD_WEBHOOK_URL=
# Discord — replay .hbr2 + resumo (se vazio, usa o de cima)
DISCORD_REPLAY_WEBHOOK_URL=
# Discord — cada ban (!ban e painel)
DISCORD_BAN_WEBHOOK_URL=
# Discord — log do chat da sala (lote a cada 4s)
DISCORD_CHAT_WEBHOOK_URL=
DISCORD_CHAT_FLUSH_MS=4000
# Discord — log único de todas as salas (vazio = default do código)
DISCORD_CENTRAL_WEBHOOK_URL=
DISCORD_ROOM_TAG=X4NIVEL

# API local de token / restart (porta diferente da x4)
TOKEN_API_PORT=3852
TOKEN_API_SECRET=troque-este-secret
PM2_PROCESS_NAME=sala-x4-nivel

# Discord da comunidade (comando !discord)
DISCORD_INVITE_URL=https://discord.gg/ZTu7zwgvhm

# Site (comando !site) e carrossel a cada 10 min
SITE_URL=https://www.haxbook.com.br
CAROUSEL_MS=600000

# API do site — room própria no back (não reutilizar comunax4).
# HAXBOOK_STATS_URL=https://api.haxbook.com.br/api/webhooks/servers/COMUNISMO/rooms/comunax4nivel/stats
HAXBOOK_API_KEY=
HAXBOOK_ROOM_NAME=Haxbook X4 Nível
