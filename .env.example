# Haxball (atualizado também via POST /token)
HAXBALL_TOKEN=

# Sala
ROOM_NAME=☭🚩 FUTZERA | X4 RETURN 🚩☭
ROOM_PUBLIC=true
ROOM_MAX_PLAYERS=30
ROOM_PASSWORD=
# Bandeira 🇨🇳; ~163km de Pouso Alegre (mesma faixa Futsalzito / Xupiscarena)
GEO=CN
GEO_LAT=-23.0295
GEO_LON=-47.2673

# Mapas — arquivos em maps/ (padrão). Ou cole o JSON numa linha em MAP_TRAINING / MAP_X4
MAP_TRAINING_FILE=maps/maptraining.hbs
MAP_X4_FILE=maps/mapx4.hbs
MAP_TRAINING=
MAP_X4=

# Score / tempo
SCORE_LIMIT=3
TIME_LIMIT=3
TEAM_SIZE=4
CHOOSE_TIME_SEC=20

# AFK (ms) — por jogador, desde a última atividade
AFK_WARN_MS=5000
AFK_ACTION_MS=10000
# Considera "cheia" a partir deste número de jogadores (kick AFK); abaixo disso move p/ spec
AFK_FULL_THRESHOLD=12

# Anti-abuso na entrada
# Mesma auth já na sala → kicka a sessão antiga (reconexão/aba duplicada)
GHOST_KICK=true
# Máximo de jogadores pela mesma conexão (0 = sem limite)
MAX_PER_CONN=2

# Supabase (service role só na VM)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord — entradas (auth/conn/IP)
DISCORD_WEBHOOK_URL=
# Discord — replay .hbr2 + resumo (se vazio, usa o de cima)
DISCORD_REPLAY_WEBHOOK_URL=

# API local de token / restart (só na VM, proteja com secret)
TOKEN_API_PORT=3847
TOKEN_API_SECRET=troque-este-secret
PM2_PROCESS_NAME=sala-x4
